# Copy to .env.local. Never put a real key in this file or in client code.
# This public studio stays in DEMO mode until live generation is explicitly enabled
# AND protected by GENERATION_ACCESS_TOKEN. The website does not send that token.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Set to the exact word "enabled" only on a private, access-controlled deployment.
# Leaving this as "disabled" is the production default, including on Vercel.
LIVE_GENERATION=disabled

# Shared secret required before any live provider call. Not a full account system.
# In-memory rate limits are not spending protection and this app does not use them as one.
GENERATION_ACCESS_TOKEN=

# Set to 1 only in test runs that need a simulated track failure. Never in deployment.
ENABLE_GENERATION_TEST_HOOKS=
